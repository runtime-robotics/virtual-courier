{
  // VS Code: «Dev Containers: Reopen in Container» — откроет пакет solution внутри контейнера
  // с ROS 2, автодополнением и терминалом. Сцена поднимается автоматически.
  "name": "Virtual Courier — solution",
  "dockerComposeFile": ["../docker-compose.yaml"],
  "service": "solution",
  "runServices": ["scene", "solution"],
  "workspaceFolder": "/ros_ws/src/solution",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.analysis.extraPaths": [
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/opt/ros/humble/local/lib/python3.10/dist-packages"
        ],
        "ros.distro": "humble"
      }
    }
  }
}
